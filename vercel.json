{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/jobs/diario",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/jobs/perfiles",
      "schedule": "0 7 * * *"
    }
  ]
}
